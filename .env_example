# BASE URL
# Local dev (vite dev talks straight to the backend): http://localhost:1234/api/
# Production build (served via server.js, proxied same-origin so the
# refresh-token cookie is first-party): VITE_BASE_URL=/api/
VITE_BASE_URL=http://localhost:1234/api/

# Server-side only (used by server.js, NOT inlined into the client bundle).
# The backend origin that /api requests get proxied to in production.
# e.g. API_PROXY_TARGET=https://beanaksehat-app.up.railway.app
API_PROXY_TARGET=

# AUTH 
VITE_API_LOGIN=auth/login
VITE_API_REGISTER_PARENT=auth/register/parent
VITE_API_REGISTER_INSTITUTION=auth/register/institution
VITE_API_LOGOUT=auth/logout
VITE_API_REFRESH_TOKEN=token

# USERS
VITE_API_GET_USERS=users

# PROVINCES
VITE_API_GET_PROVINCES=province

# CITIES
VITE_API_GET_CITIES=city

# INSTITUTIONS
VITE_API_GET_INSTITUTIONS=institutions
VITE_API_GET_INSTITUTIONS_TYPE=institutionType

# CATEGORIES
VITE_API_GET_CATEGORIES=categories